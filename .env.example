# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 커밋 금지)
# --- v1: 문맥형 민감정보 AI 판단 (비워두면 규칙 탐지만 동작) ---
# 코디세이 제공 키 (sk-cody-...). 반드시 코디세이 주소와 함께 사용
OPENAI_API_KEY=
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5-mini
# 로컬 GPU(Ollama)로 바꿀 때 예시:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen3:8b
# (선택) 판정 '설명' 생성에만 다른 모델 사용 - 설명은 판정에 영향이 없으므로 빠른 모델로 시험 가능
# EXPLAIN_MODEL=gpt-5.4-mini
